require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

# CocoaPods 1.16.2 bundles xcodeproj 1.27.0, which can create Pods.xcodeproj
# using the user project's objectVersion but has no compatibility string for 70.
# Xcode 16+/26 often bumps App.xcodeproj to 70 (Folders / Project Format).
# Patch the mapping and normalize the on-disk project before install.
require 'xcodeproj'
compat = Xcodeproj::Constants::COMPATIBILITY_VERSION_BY_OBJECT_VERSION
unless compat.key?(70)
  patched = compat.dup
  patched[70] = 'Xcode 16.0'
  patched[71] = 'Xcode 16.2' unless patched.key?(71)
  Xcodeproj::Constants.send(:remove_const, :COMPATIBILITY_VERSION_BY_OBJECT_VERSION)
  Xcodeproj::Constants.const_set(:COMPATIBILITY_VERSION_BY_OBJECT_VERSION, patched.freeze)
end

pbxproj_path = File.expand_path('App.xcodeproj/project.pbxproj', __dir__)
if File.file?(pbxproj_path)
  pbx = File.read(pbxproj_path)
  if pbx.include?('objectVersion = 70;')
    File.write(pbxproj_path, pbx.sub('objectVersion = 70;', 'objectVersion = 56;'))
    Pod::UI.puts '[Feedback] Normalized App.xcodeproj objectVersion 70 → 56 (CocoaPods xcodeproj 1.27.0)'
  end
end

platform :ios, '15.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCommunityAppleSignIn', :path => '../../node_modules/@capacitor-community/apple-sign-in'
  pod 'CapacitorCommunityMedia', :path => '../../node_modules/@capacitor-community/media'
  pod 'CapacitorApp', :path => '../../node_modules/@capacitor/app'
  pod 'CapacitorBrowser', :path => '../../node_modules/@capacitor/browser'
  pod 'CapacitorFilesystem', :path => '../../node_modules/@capacitor/filesystem'
  pod 'CapacitorGeolocation', :path => '../../node_modules/@capacitor/geolocation'
  pod 'CapacitorHaptics', :path => '../../node_modules/@capacitor/haptics'
  pod 'CapacitorPushNotifications', :path => '../../node_modules/@capacitor/push-notifications'
  pod 'CapgoCameraPreview', :path => '../../node_modules/@capgo/camera-preview'
  pod 'CapgoCapacitorSocialLogin', :path => '../../node_modules/@capgo/capacitor-social-login'
  pod 'FeedbackNativeAudioCapture', :path => '../../packages/native-audio-capture'
  pod 'FeedbackShazamkit', :path => '../../packages/shazamkit'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # Newer Xcode treats quoted includes in framework headers as errors; CocoaPods
      # libs (Capacitor Cordova, SDWebImage) still use them. Keep them as warnings.
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'

      # Vendor pods — silence deprecation / unused-variable noise we cannot patch sustainably.
      next if ['FeedbackNativeAudioCapture', 'FeedbackShazamkit'].include?(target.name)

      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
    end

    # Xcode 15+: expected when install! uses disable_input_output_paths (Capacitor cache workaround).
    target.shell_script_build_phases.each do |phase|
      next unless phase.name&.start_with?('[CP]')

      phase.always_out_of_date = '1'
    end
  end

  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |target|
      target.shell_script_build_phases.each do |phase|
        next unless phase.name&.start_with?('[CP]')

        phase.always_out_of_date = '1'
      end
    end
    aggregate_target.user_project.save
  end

  installer.pods_project.root_object.attributes['LastUpgradeCheck'] = '1600'
  installer.pods_project.root_object.attributes['LastSwiftUpdateCheck'] = '1600'
end
